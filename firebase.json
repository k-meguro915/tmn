{
  "hosting": {
    "site": "tmcapsule-e9c79-cde99",
    "public": "./",
    "ignore": [
      "firebase.json",
      "package.json",
      "package-lock.json",
      "extract.py",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/root_box/**",
        "destination": "/root_box.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
